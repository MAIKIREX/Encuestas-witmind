# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# material de referencia (manuales de tests con derechos de terceros, no es
# codigo de la app; algunos PDFs superan el limite de 100MB de GitHub)
/docuemntacion

# Material licenciado y clave de corrección de Raven: se usa localmente para importar.
/raven-import/clave.json
/raven-import/*_stem.png
/raven-import/*_stem.jpg
/raven-import/*_stem.jpeg
/raven-import/*_stem.webp
/raven-import/*_opt_*.png
/raven-import/*_opt_*.jpg
/raven-import/*_opt_*.jpeg
/raven-import/*_opt_*.webp
