# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor. Nunca prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Token de respaldo para el endpoint MCP remoto (/api/mcp). Opcional: los tokens
# normales se crean en Admin → MCP.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_API_TOKEN=

# URL pública del sitio (robots, sitemap, metadatos). Ej: https://encuestas.midominio.com
NEXT_PUBLIC_SITE_URL=
